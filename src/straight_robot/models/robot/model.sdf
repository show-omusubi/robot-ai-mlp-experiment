<?xml version="1.0" ?>
<sdf version="1.9">

  <model name="straight_robot">

    <pose>0 0 0 0 0 0</pose>

    <!-- =========================================
         BASE LINK
         物理計算に参加する本体
    ========================================== -->
    <link name="base_link">

      <pose>0 0 0.08 0 0 0</pose>

      <inertial>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.03</ixx>
          <iyy>0.03</iyy>
          <izz>0.03</izz>
        </inertia>
      </inertial>

      <collision name="base_collision">
        <geometry>
          <box>
            <size>0.30 0.22 0.08</size>
          </box>
        </geometry>
      </collision>

      <visual name="base_visual">
        <geometry>
          <box>
            <size>0.30 0.22 0.08</size>
          </box>
        </geometry>
        <material>
          <ambient>0.20 0.20 0.22 1</ambient>
          <diffuse>0.20 0.20 0.22 1</diffuse>
        </material>
      </visual>

      <!-- =====================================
           見た目だけの人型パーツ
           すべてvisualのみ
      ====================================== -->

      <!-- torso -->
      <visual name="torso_visual">
        <pose>0 0 0.20 0 0 0</pose>
        <geometry>
          <box>
            <size>0.18 0.12 0.24</size>
          </box>
        </geometry>
        <material>
          <ambient>0.65 0.65 0.70 1</ambient>
          <diffuse>0.65 0.65 0.70 1</diffuse>
        </material>
      </visual>

      <!-- head -->
      <visual name="head_visual">
        <pose>0 0 0.38 0 0 0</pose>
        <geometry>
          <box>
            <size>0.12 0.12 0.12</size>
          </box>
        </geometry>
        <material>
          <ambient>0.82 0.82 0.84 1</ambient>
          <diffuse>0.82 0.82 0.84 1</diffuse>
        </material>
      </visual>

      <!-- left arm -->
      <visual name="left_arm_visual">
        <pose>0 0.12 0.20 0 0 0</pose>
        <geometry>
          <box>
            <size>0.04 0.04 0.20</size>
          </box>
        </geometry>
        <material>
          <ambient>0.45 0.45 0.50 1</ambient>
          <diffuse>0.45 0.45 0.50 1</diffuse>
        </material>
      </visual>

      <!-- right arm -->
      <visual name="right_arm_visual">
        <pose>0 -0.12 0.20 0 0 0</pose>
        <geometry>
          <box>
            <size>0.04 0.04 0.20</size>
          </box>
        </geometry>
        <material>
          <ambient>0.45 0.45 0.50 1</ambient>
          <diffuse>0.45 0.45 0.50 1</diffuse>
        </material>
      </visual>

      <!-- left leg -->
      <visual name="left_leg_visual">
        <pose>0 0.05 0.03 0 0 0</pose>
        <geometry>
          <box>
            <size>0.05 0.05 0.16</size>
          </box>
        </geometry>
        <material>
          <ambient>0.35 0.35 0.40 1</ambient>
          <diffuse>0.35 0.35 0.40 1</diffuse>
        </material>
      </visual>

      <!-- right leg -->
      <visual name="right_leg_visual">
        <pose>0 -0.05 0.03 0 0 0</pose>
        <geometry>
          <box>
            <size>0.05 0.05 0.16</size>
          </box>
        </geometry>
        <material>
          <ambient>0.35 0.35 0.40 1</ambient>
          <diffuse>0.35 0.35 0.40 1</diffuse>
        </material>
      </visual>

      <!-- 前方センサ -->
      <sensor name="front_sensor" type="gpu_lidar">
        <pose>0.12 0 0.38 0 0 0</pose>
        <topic>/front_range</topic>
        <update_rate>10</update_rate>

        <ray>
          <scan>
            <horizontal>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>

          <range>
            <min>0.05</min>
            <max>5.0</max>
            <resolution>0.01</resolution>
          </range>
        </ray>

        <always_on>true</always_on>
        <visualize>true</visualize>
      </sensor>

    </link>


    <!-- =========================================
         LEFT WHEEL
    ========================================== -->
    <link name="left_wheel">

      <pose>0 0.16 0.06 0 0 0</pose>

      <inertial>
        <mass>0.15</mass>
        <inertia>
          <ixx>0.001</ixx>
          <iyy>0.001</iyy>
          <izz>0.001</izz>
        </inertia>
      </inertial>

      <collision name="collision">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.06</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name="visual">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.06</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
      </visual>

    </link>


    <!-- =========================================
         RIGHT WHEEL
    ========================================== -->
    <link name="right_wheel">

      <pose>0 -0.16 0.06 0 0 0</pose>

      <inertial>
        <mass>0.15</mass>
        <inertia>
          <ixx>0.001</ixx>
          <iyy>0.001</iyy>
          <izz>0.001</izz>
        </inertia>
      </inertial>

      <collision name="collision">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.06</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name="visual">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.06</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
      </visual>

    </link>


    <!-- =========================================
         FRONT CASTER
    ========================================== -->
    <link name="front_caster">

      <pose>0.13 0 0.03 0 0 0</pose>

      <inertial>
        <mass>0.03</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <sphere>
            <radius>0.03</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.05</mu>
              <mu2>0.05</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <visual name="visual">
        <geometry>
          <sphere>
            <radius>0.03</radius>
          </sphere>
        </geometry>
      </visual>

    </link>

    <joint name="front_caster_joint" type="fixed">
      <parent>base_link</parent>
      <child>front_caster</child>
    </joint>


    <!-- =========================================
         REAR CASTER
    ========================================== -->
    <link name="rear_caster">

      <pose>-0.13 0 0.03 0 0 0</pose>

      <inertial>
        <mass>0.03</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <sphere>
            <radius>0.03</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.05</mu>
              <mu2>0.05</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <visual name="visual">
        <geometry>
          <sphere>
            <radius>0.03</radius>
          </sphere>
        </geometry>
      </visual>

    </link>

    <joint name="rear_caster_joint" type="fixed">
      <parent>base_link</parent>
      <child>rear_caster</child>
    </joint>


    <!-- =========================================
         WHEEL JOINTS
    ========================================== -->
    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_wheel</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
      </axis>
    </joint>

    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_wheel</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
      </axis>
    </joint>


    <!-- =========================================
         DIFF DRIVE
    ========================================== -->
    <plugin
      filename="gz-sim-diff-drive-system"
      name="gz::sim::systems::DiffDrive">

      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>

      <wheel_separation>0.32</wheel_separation>
      <wheel_radius>0.06</wheel_radius>

      <topic>/cmd_vel</topic>

    </plugin>

  </model>

</sdf>
